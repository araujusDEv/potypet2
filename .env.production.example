# Referência independente de provedor. Configure os segredos no ambiente seguro escolhido.
# Não aplicar antes de resolver docs/guias/GUIA-HOSPEDAGEM.md e docs/guias/PENDENCIAS-OPERACIONAIS.md.
# O Node não carrega este arquivo automaticamente.
NODE_ENV=production
NODE_VERSION=24.21.0
DATA_DIR=/var/data/appet
PERSISTENT_DISK_PATH=/var/data
COOKIE_SECURE=1
SEED_DEMO_ACCOUNTS=0
SEED_SAMPLE_DATA=0
TRUST_PROXY=0
ADMIN_EMAIL=SEU_EMAIL_ADMIN
ADMIN_PASSWORD=DEFINIR_NO_PAINEL
DONOR_EMAIL=OUTRO_EMAIL_RESPONSAVEL
DONOR_PASSWORD=OUTRA_SENHA_NO_PAINEL
DONOR_NAME="Perfil responsável inicial"
EMAIL_TRANSPORT=smtp
MAIL_FROM=REMETENTE_OFICIAL_NO_PAINEL
SMTP_HOST=SERVIDOR_SMTP_DO_PROVEDOR
SMTP_PORT=465
SMTP_USER=USUARIO_SMTP_NO_PAINEL
SMTP_PASSWORD=SENHA_DE_APP_NO_PAINEL
# Gere 32 bytes aleatórios em base64 para instalação nova e guarde fora do código.
# Na atualização, mantenha exatamente a chave existente.
MAIL_QUEUE_KEY=CHAVE_EXISTENTE_OU_NOVA_INSTALACAO
# Defina explicitamente a origem HTTPS, independentemente do provedor:
PUBLIC_BASE_URL=https://SEU_SITE
BACKUP_AUTO=1
BACKUP_KEEP=3
BACKUP_MAX_MB=2048
BACKUP_MIN_FREE_MB=256
# Exportação externa opcional: configure todas as variáveis abaixo juntas.
# BACKUP_S3_BUCKET=SEU_BUCKET_PRIVADO
# BACKUP_S3_REGION=REGIAO_DO_BUCKET
# BACKUP_S3_ACCESS_KEY_ID=DEFINIR_NO_PAINEL
# BACKUP_S3_SECRET_ACCESS_KEY=DEFINIR_NO_PAINEL
# BACKUP_ENCRYPTION_KEY=CHAVE_ALEATORIA_32_BYTES_BASE64
# BACKUP_S3_ENDPOINT=https://ENDPOINT_SE_USAR_S3_COMPATIVEL
# BACKUP_S3_PREFIX=appet/

# Proxy: habilite somente após mapear os IPs de entrada e confirmar o header.
# TRUSTED_PROXY_IPS=IPS_OU_CIDRS_RESTRITOS_DO_PROXY
# Não use endereços de saída do provedor nem 0.0.0.0/0 ou ::/0.

# Limites de anuncios ativos e fotos/anexos por conta (MB).
USER_ANIMAL_LIMIT=50
USER_MISSING_LIMIT=10
USER_STORAGE_MB=100
ORG_ANIMAL_LIMIT=300
ORG_MISSING_LIMIT=100
ORG_STORAGE_MB=500
ADMIN_ANIMAL_LIMIT=2000
ADMIN_MISSING_LIMIT=500
ADMIN_STORAGE_MB=1024

# Apenas novas decisões: foto tecnicamente válida e descrição, sem alterar registros antigos.
ANIMAL_APPROVAL_MIN_PHOTOS=1
ANIMAL_APPROVAL_MIN_DESCRIPTION_CHARS=1
